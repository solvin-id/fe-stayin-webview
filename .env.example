# Nginep integration (leave unset for mock/demo mode)
# Public base URL of the Nginep API (informational: the browser calls the
# same-origin BFF at /api/nginep/*; the proxy uses the runtime NGINEP_API_URL).
NEXT_PUBLIC_NGINEP_API_URL=

# Build-time mode switch. "true" enables the tenant API integration, "false"
# forces the bundled mock catalog. Unset falls back to "API URL is non-empty".
NEXT_PUBLIC_NGINEP_ENABLED=

# Fallback tenant subdomain used when the host app does not pass ?tenant_id=
# (production: grand-dian).
NEXT_PUBLIC_NGINEP_TENANT=
