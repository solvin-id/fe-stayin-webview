# Nginep integration (leave unset for mock/demo mode)
# Base URL of the Nginep API gateway, e.g. http://localhost:3000
NEXT_PUBLIC_NGINEP_API_URL=

# Fallback tenant subdomain used by the webview client when no tenant is
# provided via query/sessionStorage (e.g. "grand-park")
NEXT_PUBLIC_NGINEP_TENANT=
